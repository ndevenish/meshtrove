  "query": "SELECT t.id, t.name::text AS \"name!\", t.hidden,\n                  (SELECT count(*) FROM model_tags mt WHERE mt.tag_id = t.id) AS \"model_count!\"\n             FROM tags t\n            ORDER BY t.hidden,\n                     (SELECT count(*) FROM model_tags mt WHERE mt.tag_id = t.id) DESC,\n                     t.name",
