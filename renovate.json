{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "One PR for all non-major Rust crate updates",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Rust minor updates"
    },
    {
      "description": "One PR for all non-major Node package updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Node minor updates"
    },
    {
      "description": "Below 1.0 a minor bump (0.5 -> 0.6) is semver-breaking: keep it out of the safe Rust group",
      "matchManagers": ["cargo"],
      "matchCurrentVersion": "<1.0.0",
      "matchUpdateTypes": ["minor"],
      "groupName": "Rust 0.x breaking updates"
    },
    {
      "description": "Below 1.0 a minor bump (0.5 -> 0.6) is semver-breaking: keep it out of the safe Node group",
      "matchManagers": ["npm"],
      "matchCurrentVersion": "<1.0.0",
      "matchUpdateTypes": ["minor"],
      "groupName": "Node 0.x breaking updates"
    }
  ]
}
